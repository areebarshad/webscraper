# Copy to .env and fill in. Values here override config.yaml.

# Required for the Phase 5 LLM fallback (only when SCRAPER_LLM__ENABLED=true).
ANTHROPIC_API_KEY=

# Optional overrides (SCRAPER_ prefix, __ for nesting):
# SCRAPER_VAULT_PATH=/absolute/path/to/vault
# SCRAPER_FETCH__TIMEOUT=30
# SCRAPER_THROTTLE__RATE=0.5
# SCRAPER_LLM__ENABLED=true
